{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "permissions": {
    "allow": [
      "mcp__Evernote__delete_note"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/japanese-guard.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/japanese-guard.py"
          }
        ]
      }
    ]
  }
}
